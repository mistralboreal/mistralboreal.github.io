---
/** Brand logo shared by both light and dark Velocity variants. */
import siteConfig from '@/config/site.config';
interface Props {
  size?: 'sm' | 'md' | 'lg' | 'xl' | '2xl';
  forceDark?: boolean;
  variant?: 'logomark' | 'full';
  class?: string;
}
const { size = 'md', class: className } = Astro.props;
const sizes = { sm: 'h-5 w-5', md: 'h-6 w-6', lg: 'h-8 w-8', xl: 'h-12 w-12', '2xl': 'h-24 w-24' };
---
<span class:list={['inline-flex items-center', className]}>
  <img src="/branding/mistral-boreal-logo.png" alt={siteConfig.branding.logo.alt} width="400" height="400" decoding="async" class:list={['object-contain', sizes[size]]} />
</span>
