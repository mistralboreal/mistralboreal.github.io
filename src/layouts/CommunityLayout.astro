---
import '../styles/global.css';
import '../styles/community.css';
import { hrefFor, type Locale, type OKFEntry } from '../lib/okf';

interface Props {
  title: string;
  description: string;
  language: Locale;
  currentHref: string;
  alternateHref: string;
  nav: OKFEntry[];
  contentType?: string;
}
const { title, description, language, currentHref, alternateHref, nav, contentType } = Astro.props;
const en = language === 'en-CA';
const frHref = en ? alternateHref : currentHref;
const enHref = en ? currentHref : alternateHref;
const canonical = new URL(currentHref, Astro.site).toString();
---
<!doctype html>
<html lang={language} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#ed5929" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <link rel="icon" href="/branding/mistral-boreal-logo.png" type="image/png" sizes="400x400" />
    <link rel="apple-touch-icon" href="/branding/mistral-boreal-logo.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="fr-CA" href={new URL(frHref, Astro.site).toString()} />
    <link rel="alternate" hreflang="en-CA" href={new URL(enHref, Astro.site).toString()} />
    <link rel="alternate" hreflang="x-default" href={new URL(frHref, Astro.site).toString()} />
    <link rel="alternate" type="application/rss+xml" title={en ? 'Articles in English' : 'Articles en français'} href={en ? '/en-ca/rss.xml' : '/rss.xml'} />
    <meta property="og:type" content={contentType === 'article' ? 'article' : 'website'} />
    <meta property="og:locale" content={en ? 'en_CA' : 'fr_CA'} />
    <meta property="og:site_name" content="Mistral Boréal" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <title>{title} | Mistral Boréal</title>
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('mb-theme');
          const dark = saved === 'dark' || (!saved && matchMedia('(prefers-color-scheme: dark)').matches);
          document.documentElement.classList.toggle('dark', dark);
        } catch (_) {}
      })();
    </script>
  </head>
  <body class="community-site">
    <a class="skip-link" href="#contenu">{en ? 'Skip to content' : 'Aller au contenu'}</a>
    <header class="mb-header">
      <div class="mb-container mb-header-inner">
        <a class="mb-brand" href={en ? '/en-ca/' : '/'} aria-label={en ? 'Mistral Boreal — home' : 'Mistral Boréal — accueil'}>
          <img class="mb-brand-logo" src="/branding/mistral-boreal-logo.png" alt="" width="400" height="400" loading="eager" decoding="async" fetchpriority="high" />
          <span class="mb-brand-text">Mistral <strong>Boréal</strong></span>
        </a>
        <nav class="mb-navigation" aria-label={en ? 'Main navigation' : 'Navigation principale'}>
          {nav.map((page) =>
            <a href={hrefFor(page)} aria-current={currentHref === hrefFor(page) ? 'page' : undefined}>
              {page.data.nav_label}
            </a>
          )}
        </nav>
        <div class="mb-actions">
          <div class="mb-languages" aria-label={en ? 'Language selection' : 'Choix de langue'}>
            <a href={frHref} hreflang="fr-CA" lang="fr-CA" aria-current={!en ? 'page' : undefined}>FR</a>
            <span aria-hidden="true">/</span>
            <a href={enHref} hreflang="en-CA" lang="en-CA" aria-current={en ? 'page' : undefined}>EN</a>
          </div>
          <button class="mb-theme-button" id="mb-theme" type="button" aria-label={en ? 'Toggle light and dark theme' : 'Basculer entre les thèmes clair et sombre'}>◐</button>
        </div>
      </div>
    </header>
    <div class="mb-trust-note">
      <div class="mb-container">
        <span>{en ? 'Independent Mistral AI user initiative — not officially recognized or endorsed. We hope to earn that recognition in the future.' : 'Initiative d’usagers Mistral AI indépendante — non officiellement reconnue ni soutenue. Nous espérons obtenir cette reconnaissance un jour.'}</span>
        <a href={en ? '/en-ca/community/' : '/communaute/'}>{en ? 'Our status →' : 'Notre statut →'}</a>
      </div>
    </div>
    <main id="contenu"><slot /></main>
    <footer class="mb-footer">
      <div class="mb-container mb-footer-inner">
        <div>
          <div class="mb-footer-brand">Mistral Boréal</div>
          <p>{en ? 'A free, independent, bilingual Canadian user community.' : 'Une communauté canadienne d’usagers, indépendante, bilingue et gratuite.'}</p>
          <small>{en ? 'Independent, not currently officially recognized or endorsed by Mistral AI. We hope to earn recognition in the future. Third-party trademarks belong to their owners.' : 'Initiative indépendante, actuellement non reconnue officiellement ni soutenue par Mistral AI. Nous espérons obtenir cette reconnaissance un jour. Les marques tierces appartiennent à leurs propriétaires.'}</small>
        </div>
        <div class="mb-footer-links">
          <a href="https://github.com/mistralboreal/mistralboreal.github.io" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
          <a href={en ? '/en-ca/contribute/' : '/contribuer/'}>{en ? 'Contribute' : 'Contribuer'}</a>
          <a href={en ? '/en-ca/blueprint/' : '/notre-modele/'}>{en ? 'Our blueprint' : 'Notre modèle'}</a>
        </div>
      </div>
    </footer>
    <script is:inline>
      document.querySelector('#mb-theme')?.addEventListener('click', () => {
        const dark = document.documentElement.classList.toggle('dark');
        try { localStorage.setItem('mb-theme', dark ? 'dark' : 'light'); } catch (_) {}
      });
    </script>
  </body>
</html>
